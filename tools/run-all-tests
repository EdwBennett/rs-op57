#!/usr/bin/env bash
# Runs every test in the repo: `cargo test --workspace` first, then the
# Playwright end-to-end test(s) via tools/run-e2e-tests. Stops at the first
# failure, so the e2e tests only run once the Rust tests pass.
#
# Portable, like run-e2e-tests (needs its one-time e2e setup first).
# Any arguments are passed through to run-e2e-tests, e.g.:
#   tools/run-all-tests
#   tools/run-all-tests --headed
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

cd "$REPO_DIR"

echo "==> cargo test --workspace"
cargo test --workspace

echo "==> tools/run-e2e-tests"
exec "$REPO_DIR/tools/run-e2e-tests" "$@"
